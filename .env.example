# Postgres (matches docker/docker-compose.yml)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/ai_news

# Groq API key (Llama 3.3 70B), for LLM digest summaries.
# Leave blank to fall back to deterministic (non-LLM) summaries.
GROQ_API_KEY=

# Gmail API OAuth (see README for setup). Leave paths as-is unless you
# relocate the credentials/ directory.
GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=credentials/gmail_token.json
# Set to false on a scheduled/deployed run (e.g. Render cron) -- the OAuth
# token expires ~weekly while the app stays in Google's Testing mode, and
# the browser-based re-consent can't run unattended. Keep true locally.
ENABLE_GMAIL_INGESTION=true

# SMTP for sending the daily digest (e.g. Gmail app password).
# Leave blank to build the digest without sending it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Where the daily digest email gets sent.
DIGEST_RECIPIENT_EMAIL=
